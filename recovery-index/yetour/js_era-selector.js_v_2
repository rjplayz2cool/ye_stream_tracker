(() => {
  const YEARS = ['2021', '2023', '2024', '2025', '2026'];

  function yearForOption(option) {
    if (YEARS.includes(option.dataset.year)) return option.dataset.year;
    const href = option.getAttribute('href') || '';
    if (href === '/') return '2026';
    const match = href.match(/^\/(2021|2023|2024|2025)(?:\/|$)/);
    return match ? match[1] : '';
  }

  function updateEraSelector() {
    const overlay = document.getElementById('year-overlay');
    if (!overlay) return;
    const optionContainer = overlay.querySelector('.year-options') || overlay.firstElementChild;
    if (!optionContainer) return;
    const options = [...optionContainer.querySelectorAll('.year-option-btn, a[href]')]
      .filter((option) => YEARS.includes(yearForOption(option)));
    if (!options.length) return;

    // Always rebuild chronologically; the legacy pages previously placed 2024
    // after 2025, while the 2024 archive used a separate hand-written order.
    options.sort((left, right) => Number(yearForOption(left)) - Number(yearForOption(right)))
      .forEach((option) => optionContainer.append(option));

    // Do not expose an archive that is currently serving the development
    // splash. Hide first so disabled years cannot flash before the API reply.
    options.forEach((option) => { option.hidden = true; option.setAttribute('aria-hidden', 'true'); });

    fetch('/api/eras', { credentials: 'same-origin' })
      .then((response) => {
        if (!response.ok) throw new Error('Eras unavailable');
        return response.json();
      })
      .then((enabled) => {
        options.forEach((option) => {
          const year = yearForOption(option);
          const visible = enabled && enabled[year] === true;
          option.hidden = !visible;
          option.setAttribute('aria-hidden', visible ? 'false' : 'true');
        });
      })
      .catch(() => {
        // Keep the current, successfully loaded archive reachable if the era
        // check is temporarily unavailable; unknown availability stays hidden.
        const activeYear = String(window.activeYear || '2026');
        options.forEach((option) => {
          const visible = yearForOption(option) === activeYear;
          option.hidden = !visible;
          option.setAttribute('aria-hidden', visible ? 'false' : 'true');
        });
      });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', updateEraSelector, { once: true });
  else updateEraSelector();
})();
