(() => {
  const config = window.photoboothConfig || {};
  const defaultFormats = {
    tall: {
      templateSize: { width: 259, height: 580 },
      frames: [
        { x: 39, y: 43, width: 178, height: 132 },
        { x: 39, y: 180, width: 178, height: 132 },
        { x: 39, y: 317, width: 178, height: 132 }
      ],
      directory: '',
      label: 'TALL'
    },
    square: {
      templateSize: { width: 1000, height: 1000 },
      frames: [
        { x: 59, y: 118, width: 313, height: 232.11 },
        { x: 59, y: 384.16, width: 313, height: 232.11 },
        { x: 59, y: 650.33, width: 313, height: 232.11 }
      ],
      directory: 'squareratio/',
      label: '1:1'
    }
  };
  const formats = config.formats || defaultFormats;
  let activeFormat = config.defaultFormat && formats[config.defaultFormat] ? config.defaultFormat : 'tall';
  let templateSize = formats[activeFormat].templateSize;
  let frames = formats[activeFormat].frames;
  const defaultTemplates = {
    sofistadium: 'sofistadium.png',
    ataturk: 'ataturk.png',
    gelredome: 'gelredome.png',
    dinamo: 'dinamo.png',
    raymondjames: 'raymondjames.png',
    alamodome: 'alamodome.png',
    tirana: 'tirana.png',
    soldierfield: 'soldierfield.png',
    madrid: 'madrid.png',
    algarve: 'algarve.png',
    superdome: 'superdome.png',
    cdmx: 'cdmx.png',
    almaty: 'almaty.png'
  };
  const templates = config.templates || defaultTemplates;
  const assetBase = config.assetBase || 'https://media.yetour.xyz/photobooth/';
  const overlayBase = config.overlayBase || 'https://media.yetour.xyz/photobooth/';
  const assetVersion = config.assetVersion || 1;

  const preview = document.getElementById('photobooth-preview');
  const template = document.getElementById('photobooth-template');
  const select = document.getElementById('photobooth-venue');
  const input = document.getElementById('photobooth-file-input');
  const status = document.getElementById('photobooth-status');
  const download = document.getElementById('photobooth-download');
  const slots = [...document.querySelectorAll('.photobooth-slot')];
  const modeButtons = [...document.querySelectorAll('.photobooth-mode-btn')];
  const formatButtons = [...document.querySelectorAll('.photobooth-format-btn')];
  if (!preview || !template || !select || !input || !status || !download || slots.length !== 3) return;

  const images = [null, null, null];
  let pendingSlot = null;
  let drag = null;
  let activeMode = 'color';

  function applyFormat(format) {
    const definition = formats[format];
    if (!definition) return;
    activeFormat = format;
    templateSize = definition.templateSize;
    frames = definition.frames;
    preview.dataset.format = format;
    frames.forEach((frame, index) => {
      preview.style.setProperty(`--slot-${index}-left`, `${(frame.x / templateSize.width) * 100}%`);
      preview.style.setProperty(`--slot-${index}-top`, `${(frame.y / templateSize.height) * 100}%`);
      preview.style.setProperty(`--slot-${index}-width`, `${(frame.width / templateSize.width) * 100}%`);
      preview.style.setProperty(`--slot-${index}-height`, `${(frame.height / templateSize.height) * 100}%`);
    });
    formatButtons.forEach((button) => {
      const isActive = button.dataset.format === format;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-checked', isActive ? 'true' : 'false');
    });
    renderAll();
    loadTemplate();
  }

  formatButtons.forEach((button) => {
    button.addEventListener('click', () => applyFormat(button.dataset.format));
  });

  modeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeMode = btn.dataset.mode || 'color';
      modeButtons.forEach((b) => {
        const isActive = b === btn;
        b.classList.toggle('is-active', isActive);
        b.setAttribute('aria-checked', isActive ? 'true' : 'false');
      });
    });
  });

  const overlayCache = {};
  function loadOverlay(name) {
    if (overlayCache[name]) return Promise.resolve(overlayCache[name]);
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        overlayCache[name] = img;
        resolve(img);
      };
      img.onerror = () => reject(new Error(`Failed to load overlay: ${name}`));
      img.src = `${overlayBase}${name}`;
    });
  }

  let overlaysPreloading = false;
  function ensureOverlaysPreloaded() {
    if (overlaysPreloading) return;
    overlaysPreloading = true;
    loadOverlay('screen.png').catch(() => {});
    if (config.enableBnw !== false) loadOverlay('bnw.png').catch(() => {});
  }

  document.querySelectorAll('[data-tab="photobooth"], button[data-tab="photobooth"]').forEach((tab) => {
    tab.addEventListener('click', ensureOverlaysPreloaded, { once: true });
  });

  // Versioned query avoids serving the previous low-resolution template from browser/CDN cache.
  function templateUrl() { return `${assetBase}${formats[activeFormat].directory}${templates[select.value]}?v=${encodeURIComponent(assetVersion)}`; }
  function setStatus(text) { status.textContent = text; }
  function hasPhotos() { return images.every(Boolean); }

  function cover(image, frame) {
    const scale = Math.max(frame.width / image.width, frame.height / image.height);
    return { width: image.width * scale, height: image.height * scale };
  }

  function constrain(entry, frame) {
    const dimensions = cover(entry.image, frame);
    const minX = frame.width - dimensions.width;
    const minY = frame.height - dimensions.height;
    entry.offsetX = Math.max(minX, Math.min(0, entry.offsetX));
    entry.offsetY = Math.max(minY, Math.min(0, entry.offsetY));
    return dimensions;
  }

  function renderSlot(index) {
    const slot = slots[index];
    slot.querySelectorAll('.photobooth-slot-image').forEach(node => node.remove());
    const entry = images[index];
    slot.classList.toggle('has-image', Boolean(entry));
    if (!entry) return;
    const dimensions = constrain(entry, frames[index]);
    const image = document.createElement('img');
    image.className = 'photobooth-slot-image';
    image.src = entry.image.src;
    image.draggable = false;
    image.style.width = `${(dimensions.width / frames[index].width) * 100}%`;
    image.style.height = `${(dimensions.height / frames[index].height) * 100}%`;
    image.style.left = `${(entry.offsetX / frames[index].width) * 100}%`;
    image.style.top = `${(entry.offsetY / frames[index].height) * 100}%`;
    slot.prepend(image);
  }

  function renderAll() {
    images.forEach((_, index) => renderSlot(index));
    download.disabled = !hasPhotos();
  }

  function loadTemplate() {
    template.src = templateUrl();
    template.alt = `${select.options[select.selectedIndex].text} ${formats[activeFormat].label} YeTour photo booth template`;
    setStatus(`ADD ALL THREE PHOTOS, THEN DRAG TO POSITION. ${formats[activeFormat].label} FORMAT.`);
  }

  function isSupportedImage(file) {
    if (!file) return false;
    const type = (file.type || '').toLowerCase();
    if (['image/png', 'image/jpeg', 'image/jpg', 'image/webp'].includes(type)) return true;
    return /\.(png|jpe?g|webp)$/i.test(file.name || '');
  }

  function loadFile(file, index, silent) {
    if (!isSupportedImage(file)) {
      setStatus('USE A PNG, JPG, OR WEBP IMAGE.');
      return;
    }
    const url = URL.createObjectURL(file);
    const image = new Image();
    image.onload = () => {
      const old = images[index];
      if (old) URL.revokeObjectURL(old.url);
      images[index] = { image, url, offsetX: 0, offsetY: 0 };
      constrain(images[index], frames[index]);
      renderAll();
      if (!silent) {
        setStatus(`PHOTO ${index + 1} ADDED. DRAG IT TO ADJUST THE CROP.`);
      }
    };
    image.onerror = () => {
      URL.revokeObjectURL(url);
      setStatus('THAT IMAGE COULD NOT BE OPENED. TRY ANOTHER FILE.');
    };
    image.src = url;
  }

  function hasFilePayload(e) {
    if (!e.dataTransfer || !e.dataTransfer.types) return false;
    const types = e.dataTransfer.types;
    return types.includes ? types.includes('Files') : Array.from(types).includes('Files');
  }

  function extractImageFiles(dataTransfer) {
    if (!dataTransfer) return [];
    const files = [];
    if (dataTransfer.files && dataTransfer.files.length > 0) {
      for (let i = 0; i < dataTransfer.files.length; i++) {
        const file = dataTransfer.files[i];
        if (isSupportedImage(file)) files.push(file);
      }
    } else if (dataTransfer.items && dataTransfer.items.length > 0) {
      for (let i = 0; i < dataTransfer.items.length; i++) {
        const item = dataTransfer.items[i];
        if (item.kind === 'file') {
          const file = item.getAsFile();
          if (file && isSupportedImage(file)) files.push(file);
        }
      }
    }
    return files;
  }

  function handleFilesDropped(files, startIndex) {
    if (!files || files.length === 0) {
      setStatus('USE A PNG, JPG, OR WEBP IMAGE.');
      return;
    }
    const count = Math.min(files.length, slots.length - startIndex);
    files.slice(0, count).forEach((file, offset) => {
      const targetIndex = startIndex + offset;
      loadFile(file, targetIndex, count > 1);
    });
    if (count > 1) {
      setStatus(`${count} PHOTOS ADDED. DRAG EACH TO ADJUST THE CROP.`);
    }
  }

  // Prevent default drag & drop behaviors on window so accidental misses don't open the image
  window.addEventListener('dragover', (e) => {
    if (hasFilePayload(e)) e.preventDefault();
  });
  window.addEventListener('drop', (e) => {
    if (hasFilePayload(e)) e.preventDefault();
  });

  // Drag and drop for the whole preview card
  let previewDragDepth = 0;
  preview.addEventListener('dragenter', (e) => {
    if (!hasFilePayload(e)) return;
    e.preventDefault();
    previewDragDepth++;
    preview.classList.add('is-dragover');
  });
  preview.addEventListener('dragover', (e) => {
    if (!hasFilePayload(e)) return;
    e.preventDefault();
    e.dataTransfer.dropEffect = 'copy';
    if (!preview.classList.contains('is-dragover')) {
      preview.classList.add('is-dragover');
    }
  });
  preview.addEventListener('dragleave', (e) => {
    if (!hasFilePayload(e)) return;
    e.preventDefault();
    previewDragDepth--;
    if (previewDragDepth <= 0) {
      previewDragDepth = 0;
      preview.classList.remove('is-dragover');
    }
  });
  preview.addEventListener('drop', (e) => {
    if (!hasFilePayload(e)) return;
    e.preventDefault();
    previewDragDepth = 0;
    preview.classList.remove('is-dragover');
    slots.forEach(s => s.classList.remove('is-dragover'));

    const files = extractImageFiles(e.dataTransfer);
    let startIdx = images.findIndex((img) => img === null);
    if (startIdx === -1) startIdx = 0;
    handleFilesDropped(files, startIdx);
  });

  slots.forEach((slot, index) => {
    let slotDragDepth = 0;

    slot.addEventListener('dragenter', (e) => {
      if (!hasFilePayload(e)) return;
      e.preventDefault();
      e.stopPropagation();
      slotDragDepth++;
      slot.classList.add('is-dragover');
    });

    slot.addEventListener('dragover', (e) => {
      if (!hasFilePayload(e)) return;
      e.preventDefault();
      e.stopPropagation();
      e.dataTransfer.dropEffect = 'copy';
      if (!slot.classList.contains('is-dragover')) {
        slot.classList.add('is-dragover');
      }
    });

    slot.addEventListener('dragleave', (e) => {
      if (!hasFilePayload(e)) return;
      e.preventDefault();
      e.stopPropagation();
      slotDragDepth--;
      if (slotDragDepth <= 0) {
        slotDragDepth = 0;
        slot.classList.remove('is-dragover');
      }
    });

    slot.addEventListener('drop', (e) => {
      if (!hasFilePayload(e)) return;
      e.preventDefault();
      e.stopPropagation();
      slotDragDepth = 0;
      slot.classList.remove('is-dragover');
      preview.classList.remove('is-dragover');
      slots.forEach(s => s.classList.remove('is-dragover'));

      const files = extractImageFiles(e.dataTransfer);
      handleFilesDropped(files, index);
    });

    const removeBtn = slot.querySelector('.photobooth-slot-remove');
    if (removeBtn) {
      removeBtn.addEventListener('click', (event) => {
        event.stopPropagation();
        event.preventDefault();
        if (images[index]) {
          URL.revokeObjectURL(images[index].url);
          images[index] = null;
          renderAll();
          setStatus(`PHOTO ${index + 1} REMOVED.`);
        }
      });
    }

    slot.addEventListener('click', (event) => {
      if (event.target.closest('.photobooth-slot-remove')) return;
      if (drag || images[index]) return;
      pendingSlot = index;
      input.value = '';
      input.click();
    });

    slot.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        if (event.target.closest('.photobooth-slot-remove')) return;
        if (drag || images[index]) return;
        event.preventDefault();
        pendingSlot = index;
        input.value = '';
        input.click();
      }
    });

    slot.addEventListener('pointerdown', (event) => {
      if (event.target.closest('.photobooth-slot-remove')) return;
      const entry = images[index];
      if (!entry) return;
      event.preventDefault();
      slot.setPointerCapture(event.pointerId);
      drag = { index, pointerId: event.pointerId, x: event.clientX, y: event.clientY, offsetX: entry.offsetX, offsetY: entry.offsetY };
      slot.classList.add('is-dragging');
    });

    slot.addEventListener('pointermove', (event) => {
      if (!drag || drag.index !== index || drag.pointerId !== event.pointerId) return;
      const scale = frames[index].width / slot.getBoundingClientRect().width;
      const entry = images[index];
      entry.offsetX = drag.offsetX + (event.clientX - drag.x) * scale;
      entry.offsetY = drag.offsetY + (event.clientY - drag.y) * scale;
      renderSlot(index);
    });

    const endDrag = (event) => {
      if (!drag || drag.index !== index || drag.pointerId !== event.pointerId) return;
      slot.classList.remove('is-dragging');
      drag = null;
    };
    slot.addEventListener('pointerup', endDrag);
    slot.addEventListener('pointercancel', endDrag);
  });

  input.addEventListener('change', () => {
    ensureOverlaysPreloaded();
    if (pendingSlot !== null) loadFile(input.files[0], pendingSlot);
    pendingSlot = null;
  });
  select.addEventListener('change', loadTemplate);

  function isIOS() {
    return /iPad|iPhone|iPod/.test(navigator.userAgent)
      || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  }

  function canvasToPng(canvas) {
    return new Promise((resolve, reject) => {
      canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('PNG export failed')), 'image/png');
    });
  }

  function reportClientError(kind, error, extra = {}) {
    const payload = JSON.stringify({
      kind,
      message: String(error?.message || error || 'Unknown client error').slice(0, 1000),
      stack: String(error?.stack || '').slice(0, 3000),
      path: window.location.pathname,
      ...extra
    });
    try {
      const body = new Blob([payload], { type: 'application/json' });
      if (navigator.sendBeacon && navigator.sendBeacon('/api/client-errors', body)) return;
      fetch('/api/client-errors', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body,
        keepalive: true,
        credentials: 'same-origin'
      }).catch(() => {});
    } catch (_) {}
  }

  window.addEventListener('error', (event) => {
    if (event.filename && event.filename.includes('/js/photobooth.js')) {
      reportClientError('photobooth_runtime', event.error || event.message, { line: event.lineno });
    }
  });
  function triggerDownload(url, filename) {
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    link.style.display = 'none';
    document.body.appendChild(link);
    link.click();
    link.remove();
  }

  // iOS Safari ignores synthetic <a download> for client-side blob URLs. Submitting a hidden
  // form to /api/photobooth/download returns an HTTP response with Content-Disposition: attachment,
  // which forces iOS Safari to show its native "Do you want to download '...'?" prompt directly.
  function triggerServerDownload(dataUrl, filename) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '/api/photobooth/download';
    form.style.display = 'none';

    const imgInput = document.createElement('input');
    imgInput.type = 'hidden';
    imgInput.name = 'image';
    imgInput.value = dataUrl;
    form.appendChild(imgInput);

    const nameInput = document.createElement('input');
    nameInput.type = 'hidden';
    nameInput.name = 'filename';
    nameInput.value = filename;
    form.appendChild(nameInput);

    document.body.appendChild(form);
    form.submit();
    window.setTimeout(() => form.remove(), 2000);
  }

  download.addEventListener('click', async () => {
    if (!hasPhotos() || !template.complete || !template.naturalWidth) return;

    const filename = `yetour-${select.value}-${activeFormat}-${activeMode}-photobooth.png`;
    // Open synchronously from the user gesture so Safari/iOS does not block the
    // eventual image tab after canvas rendering finishes asynchronously.
    const resultWindow = window.open('', '_blank');
    download.disabled = true;
    setStatus('BUILDING YOUR PHOTOBOOTH CARD...');
    try {
      const screenOverlay = await loadOverlay('screen.png');
      const bnwOverlay = activeMode === 'bnw' ? await loadOverlay('bnw.png') : null;

      const canvas = document.createElement('canvas');
      canvas.width = template.naturalWidth || templateSize.width;
      canvas.height = template.naturalHeight || templateSize.height;
      const ctx = canvas.getContext('2d');
      const scaleX = canvas.width / templateSize.width;
      const scaleY = canvas.height / templateSize.height;

      ctx.drawImage(template, 0, 0, canvas.width, canvas.height);
      images.forEach((entry, index) => {
        if (!entry) return;
        const frame = frames[index];
        const dimensions = constrain(entry, frame);
        ctx.save();
        ctx.beginPath();
        ctx.rect(frame.x * scaleX, frame.y * scaleY, frame.width * scaleX, frame.height * scaleY);
        ctx.clip();
        ctx.drawImage(entry.image,
          (frame.x + entry.offsetX) * scaleX,
          (frame.y + entry.offsetY) * scaleY,
          dimensions.width * scaleX,
          dimensions.height * scaleY);
        ctx.restore();
      });

      ctx.save();
      ctx.globalCompositeOperation = 'screen';
      ctx.globalAlpha = 0.5;
      ctx.drawImage(screenOverlay, 0, 0, canvas.width, canvas.height);
      ctx.restore();

      if (bnwOverlay) {
        ctx.save();
        ctx.globalCompositeOperation = 'saturation';
        ctx.globalAlpha = 1.0;
        ctx.drawImage(bnwOverlay, 0, 0, canvas.width, canvas.height);
        ctx.restore();
      }

      const blob = await canvasToPng(canvas);
      const objectUrl = URL.createObjectURL(blob);
      if (resultWindow && !resultWindow.closed) {
        resultWindow.document.title = filename;
        resultWindow.location.href = objectUrl;
        setStatus('YOUR PHOTOBOOTH CARD IS OPEN IN A NEW TAB. PRESS AND HOLD OR RIGHT-CLICK TO SAVE.');
        window.setTimeout(() => URL.revokeObjectURL(objectUrl), 300000);
      } else if (isIOS()) {
        // Popup-blocked fallback: retain the existing server attachment flow.
        triggerServerDownload(await new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(reader.result);
          reader.onerror = reject;
          reader.readAsDataURL(blob);
        }), filename);
        setStatus('YOUR PHOTOBOOTH CARD IS READY TO SAVE.');
        URL.revokeObjectURL(objectUrl);
      } else {
        triggerDownload(objectUrl, filename);
        setStatus('YOUR PHOTOBOOTH CARD IS READY TO SAVE.');
        window.setTimeout(() => URL.revokeObjectURL(objectUrl), 60000);
      }
    } catch (err) {
      if (resultWindow && !resultWindow.closed) resultWindow.close();
      reportClientError('photobooth_export', err, { venue: select.value, format: activeFormat, mode: activeMode });
      console.error('Photobooth export error:', err);
      setStatus('FAILED TO GENERATE CARD. PLEASE TRY AGAIN.');
    } finally {
      download.disabled = false;
    }
  });

  applyFormat(activeFormat);
})();
