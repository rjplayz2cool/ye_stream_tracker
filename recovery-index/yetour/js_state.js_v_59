
function merchAsset(folder, fileName) {
  if (fileName.startsWith('http://') || fileName.startsWith('https://')) {
    return fileName;
  }
  const activeYear = window.activeYear || '2026';
  if (activeYear === '2021') {
    return `https://media.yetour.xyz/donda/merch/${fileName}`;
  }
  if (activeYear === '2023') {
    return `https://media.yetour.xyz/vultures/2023/merch/${fileName}`;
  }
  return `https://media.yetour.xyz/merch/${folder}/${fileName}`;
}

function formatMerchName(folder, base) {
  const folderName = folder.charAt(0).toUpperCase() + folder.slice(1);
  const trimmedBase = base.startsWith(folderName) ? base.slice(folderName.length) : base;
  return trimmedBase
    .replace(/_/g, ' ')
    .replace(/([a-z])([A-Z0-9])/g, '$1 $2')
    .replace(/([0-9])([a-np-zA-NP-Z])/g, '$1 $2')
    .trim()
    .toUpperCase();
}

function formatMerchFolderLabel(folder) {
  if (folder === 'GBK') return 'Gelora Bung Karno';
  if (folder === 'neworleans') return 'SUPERDOME';
  if (folder === 'soldierfield') return 'SOLDIER FIELD';
  if (folder === 'almaty') return 'ALMATY CENTRAL';
  return folder.toUpperCase();
}

function createMerchProduct(folder, base, files, name) {
  const images = files.map(fileName => merchAsset(folder, fileName));
  const originalName = formatMerchName(folder, base);
  return {
    id: `merch-${folder}-${base}`,
    name: name || originalName,
    slug: name ? originalName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') : undefined,
    spec: `${images.length} IMAGE${images.length === 1 ? '' : 'S'}`,
    category: 'merch',
    folder,
    folderLabel: formatMerchFolderLabel(folder),
    accessible: true,
    image: images[0],
    images
  };
}

function getProductSlug(p) {
  if (!p || !p.name) return '';
  if ((p.category === 'shop' || p.category === 'merch') && p.slug) return String(p.slug);
  return p.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}


