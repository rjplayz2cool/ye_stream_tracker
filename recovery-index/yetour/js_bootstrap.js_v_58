const activeYear = window.activeYear || '2026';
fetch(`/api/catalog/${activeYear}`)
  .then(r => {
    if (!r.ok) throw new Error('Catalog unavailable');
    return r.json();
  })
  .then(catalog => {
    const brain = catalog.config || {};
    siteBrainConfig = brain;
    if (brain.devMode) {
      document.body.innerHTML = `
        <div style="
          display: flex;
          align-items: center;
          justify-content: center;
          min-height: 100vh;
          padding: 24px;
          box-sizing: border-box;
          font-family: ${activeYear === '2023' ? "'OCR-B Std', monospace" : "'IBM Plex Mono', monospace"};
          font-size: 13px;
          letter-spacing: 0.05em;
          text-transform: uppercase;
          text-align: center;
          line-height: 1.6;
          color: #000;
          background: ${activeYear === '2023' ? '#f3f3ee' : '#fff'};
          position: relative;
        ">
          ${activeYear === '2023' ? 'UPDATING SPLY. CHECK BACK LATER' : 'WE ARE NOT ACCEPTING VISITORS AT THIS TIME.'}
          <button id="bypass-btn" style="
            position: absolute;
            bottom: 24px;
            right: 24px;
            background: none;
            border: none;
            color: rgba(0,0,0,0.3);
            font-family: inherit;
            font-size: 11px;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            cursor: pointer;
            padding: 8px;
            transition: color 0.2s ease;
          ">
            Admin Login
          </button>
        </div>

        <div id="dialog-overlay" style="
          position: fixed;
          top: 0;
          left: 0;
          width: 100vw;
          height: 100vh;
          background: ${activeYear === '2023' ? 'rgba(243, 243, 238, 0.85)' : 'rgba(255, 255, 255, 0.85)'};
          backdrop-filter: blur(8px);
          -webkit-backdrop-filter: blur(8px);
          display: none;
          align-items: center;
          justify-content: center;
          z-index: 99999;
          font-family: ${activeYear === '2023' ? "'OCR-B Std', monospace" : "'IBM Plex Mono', monospace"};
        ">
          <div style="
            width: min(320px, 90vw);
            background: ${activeYear === '2023' ? '#f3f3ee' : '#fff'};
            border: 1px solid #000;
            padding: 32px;
            box-sizing: border-box;
            text-align: center;
          ">
            <div style="
              font-size: 12px;
              font-weight: 600;
              letter-spacing: 0.08em;
              margin-bottom: 24px;
              text-transform: uppercase;
              color: #000;
            ">ADMIN ACCESS</div>
            <input type="password" id="dialog-pwd" placeholder="ENTER ACCESS KEY" style="
              width: 100%;
              border: none;
              border-bottom: 1px solid rgba(0,0,0,0.15);
              padding: 8px 0;
              margin-bottom: 24px;
              font-family: inherit;
              font-size: 12px;
              text-align: center;
              outline: none;
              background: transparent;
              letter-spacing: 0.05em;
              text-transform: uppercase;
              border-radius: 0;
            ">
            <button id="dialog-submit" style="
              width: 100%;
              background: #000;
              color: #fff;
              border: none;
              padding: 12px;
              font-size: 11px;
              letter-spacing: 0.08em;
              text-transform: uppercase;
              cursor: pointer;
              margin-bottom: 12px;
              font-family: inherit;
            ">AUTHORIZE</button>
            <div id="dialog-error" style="
              font-size: 10px;
              color: #c00;
              letter-spacing: 0.05em;
              margin-bottom: 12px;
              text-transform: uppercase;
              min-height: 15px;
            "></div>
            <button id="dialog-cancel" style="
              background: none;
              border: none;
              color: rgba(0,0,0,0.4);
              font-size: 10px;
              letter-spacing: 0.08em;
              text-transform: uppercase;
              cursor: pointer;
              font-family: inherit;
              padding: 4px;
            ">CANCEL</button>
          </div>
        </div>
      `;
      document.body.style.overflow = 'hidden';

      const overlay = document.getElementById('dialog-overlay');
      const bypassBtn = document.getElementById('bypass-btn');
      const cancelBtn = document.getElementById('dialog-cancel');
      const submitBtn = document.getElementById('dialog-submit');
      const pwdInput = document.getElementById('dialog-pwd');
      const errorDiv = document.getElementById('dialog-error');

      bypassBtn.addEventListener('click', () => {
        overlay.style.display = 'flex';
        pwdInput.value = '';
        errorDiv.textContent = '';
        pwdInput.focus();
      });
      bypassBtn.addEventListener('pointerenter', () => { bypassBtn.style.color = '#000'; });
      bypassBtn.addEventListener('pointerleave', () => { bypassBtn.style.color = 'rgba(0,0,0,0.3)'; });

      cancelBtn.addEventListener('click', () => {
        overlay.style.display = 'none';
      });

      pwdInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') submitBtn.click();
      });

      submitBtn.addEventListener('click', async () => {
        const pwd = pwdInput.value.trim();
        if (!pwd) return;

        submitBtn.textContent = 'AUTHORIZING...';
        submitBtn.style.pointerEvents = 'none';
        errorDiv.textContent = '';

        try {
          const res = await fetch('/api/admin/login', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            credentials: 'same-origin',
            body: JSON.stringify({ password: pwd })
          });
          if (res.ok) {
            window.location.reload();
          } else {
            errorDiv.textContent = 'INVALID ACCESS KEY';
            submitBtn.textContent = 'AUTHORIZE';
            submitBtn.style.pointerEvents = '';
          }
        } catch (e) {
          errorDiv.textContent = 'CONNECTION ERROR';
          submitBtn.textContent = 'AUTHORIZE';
          submitBtn.style.pointerEvents = '';
        }
      });

      throw new Error('devMode active');
    }
    if (brain.tabs) {
      Object.keys(brain.tabs).forEach(tabKey => {
        const visible = brain.tabs[tabKey];
        const btn = document.querySelector(`.filter-btn[data-filter="${tabKey}"]`);
        if (btn) {
          btn.style.display = visible ? '' : 'none';
        }
      });

      if (brain.tabs[currentFilter] === false) {
        const firstVisibleTab = Object.keys(brain.tabs).find(k => brain.tabs[k] !== false);
        if (firstVisibleTab) {
          currentFilter = firstVisibleTab;
          const activeBtn = document.querySelector(`.filter-btn[data-filter="${firstVisibleTab}"]`);
          if (activeBtn) {
            filterBtns.forEach(b => b.classList.toggle('active', b === activeBtn));
          }
        }
      }
    }

    return catalog;
  })
  .then(catalog => {
    const shows = catalog.shows || [];
    const merchRaw = catalog.merch || [];
    const musicVids = catalog.music || [];
    showsData = shows;
    const merchProducts = processMerchRaw(merchRaw);
    const musicVidProducts = musicVids.map(vid => ({
      ...vid,
      category: 'musicvideo'
    }));
    catalogProducts = [...shows, ...merchProducts, ...musicVidProducts];
    init();
    if (typeof initYedia === 'function') initYedia();
    if (typeof initFeedback === 'function') initFeedback();
    checkInitialRoute();
    setupPopstateListener();
  })
  .catch(err => {
    if (err.message !== 'devMode active') {
      console.error('Failed to load catalog data:', err);
      const gridElem = document.getElementById('grid');
      if (gridElem && (!catalogProducts || catalogProducts.length === 0)) {
        gridElem.innerHTML = `
          <div style="grid-column: 1 / -1; padding: 48px 16px; text-align: center; font-family: monospace;">
            <p style="margin-bottom: 16px; font-weight: bold; letter-spacing: 0.05em;">UNABLE TO LOAD ARCHIVE CATALOG</p>
            <button onclick="window.location.reload()" style="background: #000; color: #fff; border: 1px solid #000; padding: 8px 20px; font-family: monospace; font-size: 12px; cursor: pointer; letter-spacing: 0.1em;">RETRY</button>
          </div>
        `;
      }
    }
  });

function processMerchRaw(merchRaw) {
  return merchRaw.map(({ folder, base, files, name }) => createMerchProduct(folder, base, files, name));
}

function init() {
  grid.textContent = '';
  cardEls.clear();
  appendProductCards(catalogProducts);

  applyFilter(currentFilter, false);
  merchFilterBar.classList.toggle('show', currentFilter === 'merch');
  yediaFilterBar.classList.toggle('show', currentFilter === 'upload');
  musicvideoFilterBar.classList.toggle('show', currentFilter === 'musicvideo');
}

function appendProductCards(products) {
  const fragment = document.createDocumentFragment();
  products.forEach(p => {
    if (p.category === 'tour') return;
    const card = document.createElement('button');
    card.className = 'product-card';
    if (p.category === 'merch') {
      card.classList.add('is-merch');
      if (p.name && p.name.toUpperCase().includes('POD')) {
        card.classList.add('is-pods');
      }
    }
    if (p.thumbnailFit === 'cover') {
      card.classList.add('has-cover-thumbnail');
    }
    const isClickable = p.category !== 'live' || p.accessible;

    if (!isClickable) {
      card.classList.add('is-disabled');
      card.setAttribute('aria-disabled', 'true');
    }
    const imageWrap = document.createElement('div');
    imageWrap.className = 'image-wrap';
    const image = document.createElement('img');
    image.src = p.image || '/assets/image.png';
    image.alt = String(p.name || 'Archive media');
    image.loading = 'lazy';
    image.decoding = 'async';
    image.addEventListener('load', () => image.classList.add('loaded'), { once: true });
    imageWrap.appendChild(image);
    const copy = document.createElement('div');
    copy.className = 'card-copy';
    const name = document.createElement('div');
    name.className = 'name';
    name.textContent = p.name || 'UNKNOWN';
    copy.appendChild(name);
    const collection = p.category === 'merch' ? p.folderLabel : '';
    if (collection) {
      const collectionNode = document.createElement('div');
      collectionNode.className = 'collection';
      collectionNode.textContent = collection;
      copy.appendChild(collectionNode);
    }
    card.append(imageWrap, copy);

    if (isClickable) {
      card.addEventListener('click', () => openDetail(p));
    }
    fragment.appendChild(card);
    cardEls.set(`${p.category}-${p.id}`, card);
  });
  grid.appendChild(fragment);
}

function applyFilter(filter, animate) {
  const prevRects = new Map();
  if (animate) {
    cardEls.forEach((el, id) => {
      if (!el.classList.contains('card-hidden')) {
        prevRects.set(id, el.getBoundingClientRect());
      }
    });
  }

  catalogProducts.forEach(p => {
    const el = cardEls.get(`${p.category}-${p.id}`);
    if (!el) return;
    const merchMatches = currentMerchFilter === 'all' || p.folder === currentMerchFilter;
    const isMusicCategory = p.category === 'musicvideo' || p.category === 'visualizer';
    const matchesTopFilter = filter === 'musicvideo' ? isMusicCategory : p.category === filter;
    const musicvideoMatches = currentMusicvideoFilter === 'all' ||
      (currentMusicvideoFilter === 'video' && p.category === 'musicvideo' && p.type !== 'audio') ||
      (currentMusicvideoFilter === 'audio' && p.category === 'musicvideo' && p.type === 'audio') ||
      (currentMusicvideoFilter === 'visualizer' && p.category === 'visualizer');
    const shouldShow = matchesTopFilter &&
      (filter !== 'merch' || merchMatches) &&
      (filter !== 'musicvideo' || musicvideoMatches);
    el.classList.toggle('card-hidden', !shouldShow);
  });

  if (animate) {
    requestAnimationFrame(() => {
      const newRects = new Map();
      cardEls.forEach((el, id) => {
        if (!el.classList.contains('card-hidden')) {
          newRects.set(id, el.getBoundingClientRect());
        }
      });
      cardEls.forEach((el, id) => {
        if (el.classList.contains('card-hidden')) return;
        const newRect = newRects.get(id);
        const oldRect = prevRects.get(id);
        if (oldRect) {
          const dx = oldRect.left - newRect.left;
          const dy = oldRect.top - newRect.top;
          if (dx || dy) {
            el.style.transition = 'none';
            el.style.transform = `translate(${dx}px, ${dy}px)`;
            requestAnimationFrame(() => {
              el.style.transition = 'transform 0.5s cubic-bezier(.16,1,.3,1)';
              el.style.transform = '';
            });
          }
        } else {
          el.style.opacity = '0';
          el.style.transform = 'scale(0.9)';
          requestAnimationFrame(() => {
            el.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
            el.style.opacity = '1';
            el.style.transform = '';
          });
        }
      });
    });
  }
  if (uploadView) {
    uploadView.classList.toggle('show', filter === 'upload');
  }
  yediaFilterBar.classList.toggle('show', filter === 'upload');
  if (feedbackView) {
    feedbackView.classList.toggle('show', filter === 'feedback');
  }
  if (roadmapView) {
    roadmapView.classList.toggle('show', filter === 'roadmap');
  }
  if (photoboothView) {
    photoboothView.classList.toggle('show', filter === 'photobooth');
  }
  musicvideoFilterBar.classList.toggle('show', filter === 'musicvideo');
  grid.style.display = (filter === 'upload' || filter === 'feedback' || filter === 'roadmap' || filter === 'photobooth') ? 'none' : '';
}

filterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    const filter = btn.dataset.filter;
    if (filter === currentFilter) {
      // An async catalog update can leave Roadmap selected while its view is hidden.
      if (filter === 'roadmap') applyFilter(filter, false);
      return;
    }
    currentFilter = filter;
    window.scrollTo(0, 0);

    track("archive_filter_selected", {
      section: filter
    });

    filterBtns.forEach(b => b.classList.toggle('active', b === btn));
    if (filter === 'merch') {
      currentMerchFilter = 'all';
      merchFilterBtns.forEach(b => b.classList.toggle('active', b.dataset.merchFilter === 'all'));
    }
    if (filter === 'musicvideo') {
      currentMusicvideoFilter = 'all';
      musicvideoFilterBtns.forEach(b => b.classList.toggle('active', b.dataset.musicvideoFilter === 'all'));
    }
    if (filter === 'upload') {
      currentYediaFilter = 'all';
      document.querySelectorAll('.yedia-filter-btn').forEach(b => b.classList.toggle('active', b.dataset.yediaFilter === 'all'));
      loadApprovedMedia();
    }
    if (filter === 'feedback') {
      if (feedbackInstagramInput) feedbackInstagramInput.value = '';
      if (feedbackTextInput) feedbackTextInput.value = '';
      if (feedbackStatus) {
        feedbackStatus.textContent = '';
        feedbackStatus.className = 'feedback-status';
      }
    }
    merchFilterBar.classList.toggle('show', filter === 'merch');
    yediaFilterBar.classList.toggle('show', filter === 'upload');
    musicvideoFilterBar.classList.toggle('show', filter === 'musicvideo');
    // Pause all grid video thumbnails when switching tabs
    document.querySelectorAll('.yedia-photo-grid video, #photo-grid video').forEach(v => { v.pause(); v.src = ''; });
    applyFilter(filter, true);
  });
});

merchFilterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    const filter = btn.dataset.merchFilter;
    if (filter === currentMerchFilter) return;
    currentMerchFilter = filter;

    merchFilterBtns.forEach(b => b.classList.toggle('active', b === btn));
    applyFilter(currentFilter, true);
  });
});

musicvideoFilterBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    const filter = btn.dataset.musicvideoFilter;
    if (filter === currentMusicvideoFilter) return;
    currentMusicvideoFilter = filter;

    musicvideoFilterBtns.forEach(b => b.classList.toggle('active', b === btn));
    applyFilter(currentFilter, true);
  });
});

const privacyBtn = document.getElementById('privacy-policy-btn');
const privacyModalOverlay = document.getElementById('privacy-modal-overlay');
const privacyModalClose = document.getElementById('privacy-modal-close');

if (privacyBtn && privacyModalOverlay && privacyModalClose) {
  privacyBtn.addEventListener('click', () => {
    privacyModalOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  });

  const closePrivacyModal = () => {
    privacyModalOverlay.classList.remove('active');
    document.body.style.overflow = '';
  };

  privacyModalClose.addEventListener('click', closePrivacyModal);
  
  privacyModalOverlay.addEventListener('click', (e) => {
    if (e.target === privacyModalOverlay) {
      closePrivacyModal();
    }
  });
}

const termsBtn = document.getElementById('terms-btn');
const termsModalOverlay = document.getElementById('terms-modal-overlay');
const termsModalClose = document.getElementById('terms-modal-close');

if (termsBtn && termsModalOverlay && termsModalClose) {
  termsBtn.addEventListener('click', () => {
    termsModalOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  });

  const closeTermsModal = () => {
    termsModalOverlay.classList.remove('active');
    document.body.style.overflow = '';
  };

  termsModalClose.addEventListener('click', closeTermsModal);
  
  termsModalOverlay.addEventListener('click', (e) => {
    if (e.target === termsModalOverlay) {
      closeTermsModal();
    }
  });
}

// Wire up Tour Info modal close handlers once on page load
if (tourInfoModalOverlay && tourInfoModalClose) {
  tourInfoModalClose.addEventListener('click', () => {
    tourInfoModalOverlay.classList.remove('active');
    document.body.style.overflow = '';
  });
  tourInfoModalOverlay.addEventListener('click', (e) => {
    if (e.target === tourInfoModalOverlay) {
      tourInfoModalOverlay.classList.remove('active');
      document.body.style.overflow = '';
    }
  });
}
